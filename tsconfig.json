{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": false,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "types": ["vite/client"]
    },
    "include": ["src/app", "src/styles", "vite.config.ts"]
}
