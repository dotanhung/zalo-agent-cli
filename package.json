{
  "name": "zalo-agent-cli",
  "version": "1.7.0",
  "description": "CLI tool for Zalo automation — multi-account, proxy, bank transfers, QR payments, Official Account API v3.0",
  "type": "module",
  "bin": {
    "zalo-agent": "src/index.js"
  },
  "main": "./src/index.js",
  "files": [
    "src/index.js",
    "src/commands",
    "src/core",
    "src/mcp",
    "src/utils",
    "LICENSE",
    "DISCLAIMER.md"
  ],
  "scripts": {
    "test": "node --test src/*.test.js src/**/*.test.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "release": "npm version patch -m 'release: v%s' && git push origin main --tags",
    "prepublishOnly": "npm run lint && npm test",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "zalo",
    "cli",
    "automation",
    "messaging",
    "vietnam",
    "proxy",
    "vietqr",
    "zca-js",
    "official-account",
    "zalo-oa",
    "webhook"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PhucMPham/zalo-agent-cli"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "https-proxy-agent": "^8.0.0",
    "node-fetch": "^3.3.0",
    "undici": "^7.24.6",
    "zca-js": "^2.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.0.3",
    "lucide-react": "^1.34.0",
    "prettier": "^3.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
